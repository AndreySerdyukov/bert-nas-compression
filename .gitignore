# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
# Written by `uv pip install -e .`; build metadata, not source
*.egg-info/
# Left behind by `uv build` / `pip wheel`, which is how the packaging test's claim gets checked
build/
dist/
*.whl

# Node / Vite
node_modules/
dist/
.vite/
*.local

# Playwright output: traces and the HTML report of the last local run
test-results/
playwright-report/
.playwright/

# Model weights. Unlike the sibling projects, these are NOT rebuilt from anything in the repo:
# they are fine-tuned checkpoints that cost GPU-hours, and they live on the Hugging Face Hub.
# `backend/scripts/fetch_models.py` downloads them at pinned revisions. What IS tracked is the
# metadata that makes a download verifiable: the manifest (*.meta.json) and the per-file digests
# (*.lock.json), so an upstream replacement is detectable.
backend/models/*/
backend/models/*.pt
backend/models/*.bin
backend/models/*.safetensors

# The raw IMDB corpus (66 MB) is not ours to redistribute - see data/README.md for where to get it.
# The 2 000-row evaluation sample under backend/data/ IS tracked: the app, CI and the Docker image
# all have to score the identical rows for the numbers to mean anything.
data/*.csv

# Environment and secrets
.env
.DS_Store

# Internal working docs - kept local, not published to the repo
/PRD.md
/progress.md
/CLAUDE.md
/docs/
